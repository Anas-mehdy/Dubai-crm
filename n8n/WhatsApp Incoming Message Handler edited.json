    {
      "parameters": {
        "jsCode": "// 1. جلب سياق الحملة والرسالة الأخيرة بأمان (من أول عنصر قادم)\nconst firstItem = items.length > 0 ? items[0].json : {};\nconst currentCampaign = firstItem.current_campaign || \"No active marketing campaign\";\n\n// في حال كانت الرسالة الحالية الواصلة في الويبهوك محفوظة في حقل مخصص، وإلا نتركها فارغة للـ Agent\nconst clientReply = firstItem.last_message || \"\"; \n\n// 2. بناء سجل المحادثة من العناصر الخمسة بناءً على الحقول الحقيقية الظاهرة في الـ INPUT\nlet chatHistoryText = \"\";\n\nfor (let i = 0; i < items.length; i++) {\n    const msgJson = items[i].json;\n    \n    // التعديل الجوهري: القراءة من حقل content الظاهر في شاشتك\n    if (msgJson && msgJson.content) {\n        // تحديد المرسل بناءً على حقل direction (outbound = الشركة، inbound = العميل)\n        let sender = msgJson.direction === \"outbound\" ? \"الشركة (البوت/الحملة)\" : \"العميل\";\n        chatHistoryText += `[${sender}]: ${msgJson.content}\\n`;\n    }\n}\n\n// حماية في حال كانت كل النصوص فارغة\nif (chatHistoryText === \"\") {\n    chatHistoryText = \"لا يوجد رسائل سابقة في السجل.\";\n}\n\n// 3. إرجاع المخرج النهائي المدمج الموجه لنود الـ AI Agent\nreturn [{\n    json: {\n        current_campaign: currentCampaign,\n        formatted_history: chatHistoryText,\n        client_reply: clientReply\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -112
      ],
      "id": "833e7c6c-f0a4-4522-b982-d2eaac3873ac",
      "name": "Code in JavaScript"
